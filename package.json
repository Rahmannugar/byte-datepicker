{
  "name": "byte-datepicker",
  "version": "3.0.0",
  "description": "Lightweight, accessible React date, time, and date-time picker components.",
  "author": "Rahman Nugar",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahmannugar/byte-datepicker.git"
  },
  "homepage": "https://github.com/Rahmannugar/byte-datepicker#readme",
  "bugs": {
    "url": "https://github.com/Rahmannugar/byte-datepicker/issues"
  },
  "keywords": [
    "react",
    "datepicker",
    "date",
    "picker",
    "calendar",
    "typescript",
    "component",
    "ui",
    "month-picker",
    "year-picker",
    "time-picker",
    "datetime-picker"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --no-splitting && cp src/index.css dist/styles.css",
    "dev": "vite",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
